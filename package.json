{"description":"LaSpace — Your Language, Your Space. Cloudflare Pages + Workers + D1 + R2 deployment.","devDependencies":{"typescript":"^5.6.3","wrangler":"^3.99.0"},"name":"laspace-cloudflare","private":true,"scripts":{"build:frontend":"cd frontend && npm install && npm run build","db:create":"wrangler d1 create laspace","db:init":"wrangler d1 execute laspace --remote --file=./schema.sql","db:init:local":"wrangler d1 execute laspace --local --file=./schema.sql","deploy":"npm run build:frontend && wrangler deploy","dev":"wrangler dev","r2:create":"wrangler r2 bucket create laspace-avatars","tail":"wrangler tail"},"type":"module","version":"1.0.0"}